#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB           &kp Q         &kp W         &kp E  &kp R  &kp T  &kp Y      &kp U      &kp I  &kp O    &kp P      &kp BSPC
&kp CAPS          &kp A         &kp S         &kp D  &kp F  &kp G  &kp H      &kp J      &kp K  &kp L    &kp MINUS  &kp ENTER
&kp LSHFT         &kp Z         &kp X         &kp C  &kp V  &kp B  &mkp LCLK  &mkp RCLK  &kp N  &kp M    &kp COMMA  &kp DOT    &kp SLASH  &kp F10
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 5  &mo 2  &mo 1  &kp SPACE  &kp SPACE  &mo 4  &kp DEL  &kp F7     &kp F4
            >;
        };

        layer_1 {
            bindings = <
&trans  &none  &none           &kp UP_ARROW    &none            &none  &none               &none      &mkp MCLK            &none   &none             &trans
&none   &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &kp LA(LEFT_ARROW)  &mkp LCLK  &mkp RCLK            &mo 4   &none             &trans
&none   &none  &none           &none           &none            &none  &trans              &trans     &kp LA(RIGHT_ARROW)  &none   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none  &trans
&none   &none  &none           &none           &none            &none  &trans              &trans     &none                &trans  &trans            &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp F1     &kp F2     &kp F3     &kp F4     &kp N5     &kp LS(NUMBER_4)  &kp N7        &kp N8        &kp N9        &none          &kp DELETE
&trans      &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp PERIOD        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(GRAVE)  &trans
&trans      &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans            &trans        &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp SLASH  &trans
&trans      &none      &none      &none      &none      &none      &trans            &trans        &none         &trans        &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp SQT           &kp LS(SQT)   &kp LS(NUMBER_1)   &kp LS(NUMBER_6)  &none          &kp NON_US_BACKSLASH  &kp LS(MINUS)  &none             &none   &kp LS(NUMBER_5)  &trans
&none   &kp LS(NUMBER_2)  &kp ASTERISK  &kp MINUS          &kp EQUAL         &kp LS(EQUAL)  &kp LS(NUMBER_3)      &none          &trans            &none   &none             &trans
&none   &none             &none         &kp LS(SEMICOLON)  &none             &none          &trans                &trans         &kp LS(NUMBER_7)  &none   &none             &none   &none  &trans
&none   &none             &none         &none              &none             &none          &trans                &trans         &none             &trans  &trans            &trans
            >;
        };

        layer_5 {
            bindings = <
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans
&bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans
&bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };
    };
};
